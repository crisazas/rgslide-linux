#!/bin/sh
# /dev sin devtmpfs: repara los nodos basicos (si alguno quedo como fichero normal, lo sustituye) y puebla /dev con
# `mdev -s` segun /etc/mdev.conf. Idempotente. Lo lanza rgslide-dev.service antes de sysinit.target.
fix() {
	if [ -e "/dev/$1" ] && [ ! -c "/dev/$1" ]; then rm -f "/dev/$1"; fi
	[ -c "/dev/$1" ] || mknod -m "$4" "/dev/$1" c "$2" "$3"
	chmod "$4" "/dev/$1"
	chgrp "$5" "/dev/$1" 2>/dev/null
}
fix null 1 3 666 root
fix zero 1 5 666 root
fix full 1 7 666 root
fix random 1 8 666 root
fix urandom 1 9 666 root
fix tty 5 0 666 tty
fix ptmx 5 2 666 tty
fix kmsg 1 11 644 root
[ -e /dev/fd ] || ln -s /proc/self/fd /dev/fd
[ -e /dev/stdin ] || ln -s /proc/self/fd/0 /dev/stdin
[ -e /dev/stdout ] || ln -s /proc/self/fd/1 /dev/stdout
[ -e /dev/stderr ] || ln -s /proc/self/fd/2 /dev/stderr
mkdir -p /dev/shm /dev/pts
busybox mdev -s
exit 0
