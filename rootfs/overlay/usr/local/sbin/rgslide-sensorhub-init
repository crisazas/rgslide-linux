#!/bin/sh
# Inicializa el sensorhub tras el arranque: leer `version` hace que sensorhub.ko (version_show) envie el comando 0xCD al CM4 y ponga mcu_mode=2.
# Sin esto, habilitar un sensor da `mcu_mode == 0!` y no hay datos (medido 2026-11-26: tras leer version, el acelerometro da datos con el CH que arranca rgslide-cm4).
# Idempotente. Si el CH no responde, `cat` falla por timeout y el script sale con 0.
H=/sys/class/sprd_sensorhub/sensor_hub
i=0; while [ $i -lt 90 ] && [ ! -e $H/version ]; do sleep 1; i=$((i+1)); done
[ -e $H/version ] || { echo "rgslide-sensorhub-init: no hay $H/version" >&2; exit 0; }
i=0
while [ $i -lt 40 ]; do
  [ "$(cat $H/mcu_mode 2>/dev/null)" = 2 ] && { echo "rgslide-sensorhub-init: mcu_mode=2 (CM4 version $(cat $H/version 2>/dev/null))"; exit 0; }
  timeout 10 cat $H/version >/dev/null 2>&1
  sleep 3; i=$((i+1))
done
echo "rgslide-sensorhub-init: mcu_mode=$(cat $H/mcu_mode 2>/dev/null) tras 40 intentos; el CM4 no responde" >&2
exit 0
