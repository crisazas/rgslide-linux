#!/usr/bin/python3
# Proxy H4 entre /dev/ttyBT0 y un pty: reescribe Write_Default_Link_Policy_Settings (0x080f) quitando Hold/Park,
# que el firmware Marlin3 anuncia pero rechaza (0x12), lo que hace fallar `hciconfig up` con EINVAL.
# Lanza btattach sobre el pty esclavo (con --attach) o, si no, solo imprime la ruta del pty.
# Uso: rgslide-bt-proxy [--attach] [/dev/ttyBT0]
import os, sys, select, subprocess, tty
attach = "--attach" in sys.argv
args = [a for a in sys.argv[1:] if a != "--attach"]
tb = os.open(args[0] if args else "/dev/ttyBT0", os.O_RDWR | os.O_NOCTTY)
tty.setraw(tb)
m, s = os.openpty()
tty.setraw(s)
print(os.ttyname(s), flush=True)
if attach:
    subprocess.Popen(["btattach", "-B", os.ttyname(s), "-P", "h4"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
os.set_blocking(m, False)
buf = b""
HDR = {1: (3, 2, 1), 2: (4, 2, 2), 3: (3, 2, 1)}  # tipo: (cabecera, offset len, ancho len)
def fix(pkt):
    if pkt[0] == 1 and pkt[1] == 0x0f and pkt[2] == 0x08 and len(pkt) == 6:
        v = (pkt[4] | pkt[5] << 8) & ~0x000a
        pkt = pkt[:4] + bytes([v & 0xff, v >> 8])
    return pkt
while True:
    r, _, _ = select.select([tb, m], [], [])
    if tb in r:
        d = os.read(tb, 4096)
        if d: os.write(m, d)
    if m in r:
        try: buf += os.read(m, 4096)
        except OSError: continue
        while buf:
            h = HDR.get(buf[0])
            if not h:
                os.write(tb, buf[:1]); buf = buf[1:]; continue
            if len(buf) < 1 + h[0]: break
            ln = buf[1 + h[1]] if h[2] == 1 else buf[1 + h[1]] | buf[2 + h[1]] << 8
            n = 1 + h[0] + ln
            if len(buf) < n: break
            os.write(tb, fix(buf[:n])); buf = buf[n:]
