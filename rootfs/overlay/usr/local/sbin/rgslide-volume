#!/bin/sh
# Volumen de la Slide: 0-100 %. Se guarda en /var/lib/rgslide/volume y se aplica a "VBC DAC0 DG Set" (0-127) del DSP de audio.
# Uso: rgslide-volume get|set N|up|down|apply        (apply = reescribe el valor guardado; lo llama rgslide-audio-spk on)
# DG es una ATENUACION (MEDIDO: amplitud captada 1049 con DG=3, 130 con DG=25, 9 con DG=64; ~0,7 dB/paso). Android usa DG=25 para musica por altavoz.
# Mapa: 100 % -> DG=20 (algo mas fuerte que Android), 0 % -> DG=64 (casi mudo). dg = 64 - N*44/100.
# Escribir en el VBC con el dominio AUDCP dormido puede dar abort: se sube agdsp_access_en solo mientras se escribe.
F=/var/lib/rgslide/volume
CTL=/usr/local/lib/rgslide/ctl.py
[ "$(id -u)" = 0 ] || exec sudo -n "$0" "$@"
cur() { v=$(cat "$F" 2>/dev/null); case "$v" in ''|*[!0-9]*) v=20;; esac; echo "$v"; }
apply() {
	[ -r "$CTL" ] || { echo "falta $CTL (scripts/install-audio-mic.sh)" >&2; return 1; }
	vol=$1
	/usr/local/sbin/rgslide-agdsp-access get vol || return 1
	if [ "$vol" -eq 0 ]; then
		dg=127
		# No activar Speaker Mute + Speaker2 Mute ni VBC_DL_MUTE juntos: apagan el reloj IIS/DAC
		# y dejan hw_ptr clavado en el AGDSP. VBC DAC0 DG Set=127 atenua digitalmente a silencio total.
		python3 "$CTL" set "Speaker Mute" 0 >/dev/null 2>&1
		python3 "$CTL" set "Speaker2 Mute" 0 >/dev/null 2>&1
		python3 "$CTL" set "VBC_DL_MUTE" 0 >/dev/null 2>&1
	else
		dg=$(( 64 - vol * 44 / 100 ))
		python3 "$CTL" set "Speaker Mute" 0 >/dev/null 2>&1
		python3 "$CTL" set "Speaker2 Mute" 0 >/dev/null 2>&1
		python3 "$CTL" set "VBC_DL_MUTE" 0 >/dev/null 2>&1
	fi
	python3 "$CTL" set "VBC DAC0 DG Set" "$dg" "$dg" >/dev/null 2>&1; rc=$?
	/usr/local/sbin/rgslide-agdsp-access put vol
	return $rc
}
save() { mkdir -p "$(dirname "$F")"; echo "$1" > "$F"; }
case "${1:-get}" in
get) cur;;
set) case "$2" in ''|*[!0-9]*) echo "uso: $0 set 0-100" >&2; exit 2;; esac
	n=$2; [ "$n" -gt 100 ] && n=100; save "$n"; apply "$n"; echo "$n";;
up) n=$(( $(cur) + 5 )); [ "$n" -gt 100 ] && n=100; save "$n"; apply "$n"; echo "$n";;
down) n=$(( $(cur) - 5 )); [ "$n" -lt 0 ] && n=0; save "$n"; apply "$n"; echo "$n";;
apply) apply "$(cur)";;
*) echo "uso: $0 get|set N|up|down|apply" >&2; exit 2;;
esac
