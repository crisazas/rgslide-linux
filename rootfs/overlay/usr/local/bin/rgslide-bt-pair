#!/bin/sh
# Escaneo y emparejamiento Bluetooth para usar desde un menu (salida corta).
#   rgslide-bt-pair scan [seg]   enciende, escanea (def. 15 s) y lista dispositivos CON nombre: "MAC  nombre"
#   rgslide-bt-pair MAC          empareja + confia + conecta ese MAC (escanea unos segundos para que bluez lo vea)
#   rgslide-bt-pair list         dispositivos ya emparejados      | forget MAC   olvida uno
# Codigo de salida 0 = ok. Solo actua sobre el MAC dado; nunca empareja por su cuenta. Necesita root (sudo) o acceso a bluetoothd por dbus.
CLEAN='s/\x1b\[[0-9;?]*[A-Za-z]//g; s/\r//g'
bc() { bluetoothctl "$@" 2>&1 </dev/null | sed "$CLEAN"; }
isconn() { bc info "$1" | grep -q 'Connected: yes'; }
isprop() { bc info "$1" | grep -q "$2: yes"; }
need_hci() {
    [ -e /sys/class/bluetooth/hci0 ] || { echo "ERROR: no hay hci0 (systemctl status rgslide-bt)"; exit 2; }
    systemctl is-active -q bluetooth || { systemctl start bluetooth; sleep 2; }
    bc power on | grep -q 'succeeded' || bc show | grep -q 'Powered: yes' || { echo "ERROR: no enciende"; exit 2; }
}
named() { # MAC nombre, sin los que solo tienen la MAC como nombre
    bc devices | awk '$1=="Device"{m=$2; $1=$2=""; sub(/^ +/,""); n=$0; g=m; gsub(":","-",g); if (n!=g && n!="") print m"  "n}'
}
case "$1" in
scan)
    need_hci; T=${2:-15}
    bc --timeout "$T" scan on >/dev/null
    N=$(named); echo "$N" | grep -c . | sed 's/^/Con nombre: /'; echo "$N" | head -30; exit 0 ;;
list)
    bc devices Paired | awk '$1=="Device"{m=$2; $1=$2=""; print m" "$0}'; exit 0 ;;
forget)
    bc remove "$2"; exit 0 ;;
"" | -h | --help)
    sed -n '2,6p' "$0"; exit 1 ;;
esac
M=$(echo "$1" | tr 'a-f' 'A-F')
echo "$M" | grep -qE '^([0-9A-F]{2}:){5}[0-9A-F]{2}$' || { echo "ERROR: MAC no valida: $1"; exit 1; }
need_hci
bc pairable on >/dev/null
# una sola sesion con agente (NoInputNoOutput = Just Works, valido para mandos); el escaneo debe seguir activo mientras se empareja
LOG=$(mktemp)
{
    echo "scan on"
    i=0; while [ $i -lt 12 ]; do bc info "$M" | grep -q '^Device' && break; sleep 1; i=$((i+1)); done
    echo "[1/3] emparejando $M" >&2
    echo "pair $M"
    i=0; while [ $i -lt 30 ] && ! isprop "$M" Paired; do sleep 1; i=$((i+1)); done
    isprop "$M" Paired && { echo "trust $M"; sleep 1; echo "[2/3] confiado" >&2; echo "connect $M"
        i=0; while [ $i -lt 20 ] && ! isconn "$M"; do sleep 1; i=$((i+1)); done; }
    echo "scan off"; sleep 1; echo quit
} | bluetoothctl --agent NoInputNoOutput >"$LOG" 2>&1
bc pairable off >/dev/null
if isconn "$M" && isprop "$M" Paired; then
    echo "[3/3] OK: $(bc info "$M" | awk '/Name:/{$1="";print}') conectado"; rm -f "$LOG"; exit 0
fi
echo "FALLO: $(sed "$CLEAN" "$LOG" | grep -iE 'Failed|not available|Error|AuthenticationFailed|Timeout' | tail -2 | tr '\n' ' ')"
echo "Paired=$(isprop "$M" Paired && echo si || echo no) Conectado=$(isconn "$M" && echo si || echo no). Pon el mando en modo emparejar y repite."
rm -f "$LOG"; exit 1
