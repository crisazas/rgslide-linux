# Que hace rgslide-es cuando ES sale por "QUIT EMULATIONSTATION" (no por Reiniciar ES, Reiniciar sistema ni Apagar).
# boot-menu = vuelve a la consola de rescate (rgslide-ctl) por la serie USB, sin quedarse colgado en la pantalla (por defecto).
# restart   = reinicia rgslide-es (ES vuelve a salir solo).
# vacio     = comportamiento anterior: el servicio termina y se queda la ultima imagen.
EXIT_MODE=boot-menu
