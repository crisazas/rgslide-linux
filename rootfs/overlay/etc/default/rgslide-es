# Que hace rgslide-esde cuando ES-DE sale por "Quit ES-DE".
# ui        = abre en pantalla el menu grafico rgslide-ui (exit.menu) con el mando; al pulsar B vuelve a ES-DE (por defecto).
# restart   = relanza ES-DE directamente sin menu intermedio.
# boot-menu = arranca el menu de rescate por la serie USB (ttyGS0, rgslide-bootmenu.service).
# none      = termina el servicio sin relanzar ES-DE.
EXIT_MODE=ui
