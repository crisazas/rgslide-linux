[Unit]
Description=Bluetooth de la Slide (Marlin3 Lite): init vendor + proxy H4 + btattach
After=rgslide-wifi.service
Requires=rgslide-wifi.service
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
# Type=simple a proposito: el mtty_write de la VSC bloquea el proceso en estado D varios segundos y no debe retener multi-user.target.
# rgslide-bt-up (lanzado por rgslide-bt-prep en segundo plano) vigila hci0, arranca bluetooth.service y mata el servicio si hci0 no sale en 150 s (=> Restart).
Type=simple
EnvironmentFile=-/etc/default/rgslide-bt
ExecStart=/usr/local/sbin/rgslide-bt-prep
Restart=on-failure
RestartSec=15
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
