[Unit]
Description=Menu de rescate por consola tras salir de ES-DE
Conflicts=rgslide-esde.service rgslide-es.service
After=rgslide-esde.service rgslide-es.service

[Service]
Type=simple
User=console
Group=console
Environment=HOME=/home/console USER=console LOGNAME=console
ExecStart=/usr/local/bin/rgslide-bootmenu
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
