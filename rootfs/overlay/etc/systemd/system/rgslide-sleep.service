[Unit]
Description=Instant low-power standby on slider close and Power key (RG Slide)
After=rgslide-input.service rgslide-mdev.service
Wants=rgslide-input.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/sbin/rgslide-sleepd
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
