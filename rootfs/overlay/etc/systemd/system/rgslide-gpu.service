[Unit]
Description=GPU de la Slide: modulos de pantalla/Mali y nodos de /dev (gpu-prep)
After=rgslide-dev.service rgslide-mdev.service rgslide-cm4.service systemd-modules-load.service
Wants=rgslide-mdev.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/gpu-prep

[Install]
WantedBy=multi-user.target
