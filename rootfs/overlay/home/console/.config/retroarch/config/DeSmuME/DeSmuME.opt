desmume_advanced_timing = "enable"
desmume_cpu_mode = "interpreter"
desmume_firmware_language = "Auto"
desmume_frameskip = "0"
desmume_gfx_edgemark = "enable"
desmume_gfx_linehack = "enable"
desmume_gfx_txthack = "disable"
desmume_internal_resolution = "256x192"
desmume_load_to_memory = "disable"
desmume_mic_force_enable = "no"
desmume_mic_mode = "internal"
desmume_num_cores = "1"
desmume_pointer_device = "none"
desmume_pointer_device_acceleration_mod = "0"
desmume_pointer_device_deadzone = "15"
desmume_pointer_mouse = "enable"
desmume_pointer_stylus_jitter = "disable"
desmume_pointer_stylus_pressure = "50"
desmume_pointer_type = "touch"
desmume_screens_gap = "0"
desmume_screens_layout = "top/bottom"
