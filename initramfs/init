#!/bin/sh
# /init — initramfs de rescate para la Anbernic RG Slide (ums9620_2h10).
# Shell POSIX estricta: no usar bashismos. Objetivo: consola por USB (ACM)
# + red por USB (RNDIS) y, si aparece la particion userdata, arrancar el
# sistema real con switch_root. Si algo falla, se queda en shell de rescate.

export PATH=/sbin:/bin:/usr/sbin:/usr/bin
export HOME=/root
export TERM=linux
umask 022

# --- utilidades minimas ----------------------------------------------------
msg() { echo "[init] $*" > /dev/kmsg 2>/dev/null || true; echo "[init] $*" >&2; }
fail() { msg "FALLO: $*"; }

# --- pseudo-sistemas -------------------------------------------------------
mount -t proc     proc     /proc 2>/dev/null || fail "proc"
mount -t sysfs    sysfs    /sys  2>/dev/null || fail "sysfs"
mount -t devtmpfs devtmpfs /dev  2>/dev/null || fail "devtmpfs"
mount -t tmpfs    tmpfs    /run  2>/dev/null || fail "tmpfs /run"
mount -t devpts   devpts   /dev/pts 2>/dev/null || true
mkdir -p /dev/pts /run/lock

STAMP=$(date +%Y%m%d-%H%M%S 2>/dev/null || echo arranque)
LOGDIR=/mnt/root/var/log
LOG=""

# --- log en pstore (si el kernel lo ofrece) --------------------------------
pstore_write() {
	# $1 = fichero destino dentro de pstore; stdin = contenido
	[ -d /sys/fs/pstore ] || return 0
	if [ -e /sys/fs/pstore/dmesg-ramoops-0 ]; then
		cat > "/sys/fs/pstore/dmesg-ramoops-0" 2>/dev/null || return 0
	else
		cat > "/sys/fs/pstore/dmesg-$STAMP.log" 2>/dev/null || true
	fi
}

# --- modulos en el orden de /lib/modules/modules.load ----------------------
load_modules() {
	LIST=/lib/modules/modules.load
	[ -r "$LIST" ] || return 0
	while IFS= read -r mod; do
		case "$mod" in
			''|'#'*) continue ;;
		esac
		msg "modprobe $mod"
		modprobe "$mod" 2>&1 | while IFS= read -r l; do msg "  $l"; done || fail "modprobe $mod"
	done < "$LIST"
}

# --- gadget USB: ACM (consola) + RNDIS (red) -------------------------------
setup_gadget() {
	mount -t configfs none /sys/kernel/config 2>/dev/null || { fail "configfs"; return 1; }
	UDC_DIR=/sys/kernel/config/usb_gadget/g1
	mkdir -p "$UDC_DIR" 2>/dev/null || { fail "gadget g1"; return 1; }

	echo 0x1d6b > "$UDC_DIR/idVendor"
	echo 0x0104 > "$UDC_DIR/idProduct"
	echo 0x0100 > "$UDC_DIR/bcdDevice"
	echo 0x0200 > "$UDC_DIR/bcdUSB"
	mkdir -p "$UDC_DIR/strings/0x409"
	echo "Anbernic"      > "$UDC_DIR/strings/0x409/manufacturer"
	echo "RG Slide rescue" > "$UDC_DIR/strings/0x409/product"
	echo "rgslide-rescue" > "$UDC_DIR/strings/0x409/serialnumber"
	mkdir -p "$UDC_DIR/configs/c.1/strings/0x409"
	echo "acm+rndis" > "$UDC_DIR/configs/c.1/strings/0x409/configuration"
	echo 250        > "$UDC_DIR/configs/c.1/MaxPower"

	mkdir -p "$UDC_DIR/functions/acm.usb0"    || fail "func acm"
	mkdir -p "$UDC_DIR/functions/rndis.usb0"  || fail "func rndis"
	ln -s "$UDC_DIR/functions/acm.usb0"   "$UDC_DIR/configs/c.1/acm.usb0"   2>/dev/null || true
	ln -s "$UDC_DIR/functions/rndis.usb0" "$UDC_DIR/configs/c.1/rndis.usb0" 2>/dev/null || true

	UDC=""
	for u in /sys/class/udc/*; do
		[ -e "$u" ] || continue
		UDC=${u##*/}
		break
	done
	if [ -z "$UDC" ]; then
		fail "sin controlador UDC"
		return 1
	fi
	echo "$UDC" > "$UDC_DIR/UDC" 2>/dev/null || { fail "enlazar UDC $UDC"; return 1; }
	msg "gadget en $UDC"

	# Red USB: direccion fija en el lado del dispositivo.
	for n in 0 1 2 3; do
		IF="usb$n"
		if [ -e "/sys/class/net/$IF" ]; then
			ip link set "$IF" up 2>/dev/null || true
			ip addr add 10.55.0.2/24 dev "$IF" 2>/dev/null || true
			break
		fi
	done

	# Getty en la consola ACM cuando aparezca el tty.
	for _ in $(seq 1 50); do
		[ -c /dev/ttyGS0 ] && break
		sleep 0.1
	done
	if [ -c /dev/ttyGS0 ]; then
		msg "getty en ttyGS0"
		setsid getty 115200 ttyGS0 </dev/ttyGS0 >/dev/ttyGS0 2>&1 &
	else
		fail "no aparece /dev/ttyGS0"
	fi
}

# --- localizar userdata por PARTNAME ---------------------------------------
find_userdata() {
	for u in /sys/class/block/*/uevent; do
		[ -r "$u" ] || continue
		grep -qx 'PARTNAME=userdata' "$u" 2>/dev/null || continue
		dev=${u%/uevent}; dev=${dev##*/}
		[ -b "/dev/$dev" ] && { echo "/dev/$dev"; return 0; }
	done
	return 1
}

# --- arranque --------------------------------------------------------------
msg "initramfs de rescate $STAMP"
load_modules
setup_gadget || fail "gadget USB no disponible"

# Log a tmpfs para poder volcarlo aunque userdata no exista.
mkdir -p /run/log
LOG=/run/log/dmesg-$STAMP.log
dmesg > "$LOG" 2>/dev/null || true

PART=$(find_userdata) || PART=""
if [ -n "$PART" ]; then
	msg "userdata en $PART"
	mkdir -p /mnt/root
	if mount -t ext4 -o rw,noatime "$PART" /mnt/root; then
		mkdir -p "$LOGDIR"
		if dmesg > "$LOGDIR/dmesg-$STAMP.log" 2>/dev/null; then
			msg "log en $LOGDIR/dmesg-$STAMP.log"
		else
			fail "no se pudo escribir el log en userdata"
		fi
		# pstore tambien, con el mismo contenido.
		dmesg 2>/dev/null | pstore_write

		# busybox 1.36 no trae resize2fs: se usa el del rootfs si ya existe,
		# y si no, tune2fs tampoco crece; se avisa y se sigue.
		if command -v resize2fs >/dev/null 2>&1; then
			resize2fs "$PART" >/dev/null 2>&1 || msg "resize2fs sin efecto"
		else
			msg "sin resize2fs en este initramfs; userdata no se redimensiona"
		fi

		if [ -x /mnt/root/sbin/init ]; then
			msg "switch_root a /mnt/root/sbin/init"
			mount --move /proc /mnt/root/proc 2>/dev/null || true
			mount --move /sys  /mnt/root/sys  2>/dev/null || true
			mount --move /dev  /mnt/root/dev  2>/dev/null || true
			mount --move /run  /mnt/root/run  2>/dev/null || true
			exec switch_root /mnt/root /sbin/init
			fail "switch_root fallo"
		else
			fail "$PART sin /sbin/init"
		fi
	else
		fail "no se pudo montar $PART"
	fi
else
	fail "no hay particion PARTNAME=userdata"
fi

# --- rescate ---------------------------------------------------------------
msg "SHELL DE RESCATE (salir = reiniciar; Alt+SysRq+B)"
dmesg 2>/dev/null | pstore_write
cd /root 2>/dev/null || cd /
setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1' &
exec sh -c 'exec sh </dev/console >/dev/console 2>&1'
