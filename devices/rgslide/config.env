# Perfil de hardware para Anbernic RG Slide (ums9620_2h10)
DEVICE_NAME="rgslide"
DEVICE_PRETTY_NAME="Anbernic RG Slide"
SOC="ums9620_2h10"
ARCH="arm64"

# Pantalla
SCREEN_RES="1280x960"
SCREEN_WIDTH=1280
SCREEN_HEIGHT=960
SCREEN_ROTATION=0
SCREEN_MAX_HZ=120

# Caracteristicas de hardware
HAS_SLIDER=1
SLIDER_EVENT_DEV="/dev/input/event0"
JOYPAD_DEV="/dev/input/event3"
JOYPAD_NAME="retrogame_joypad"
HAS_RGB_LEDS=0
