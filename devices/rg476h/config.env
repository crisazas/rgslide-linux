# Perfil de hardware para Anbernic RG476H (ums9620_2h10)
DEVICE_NAME="rg476h"
DEVICE_PRETTY_NAME="Anbernic RG476H"
SOC="ums9620_2h10"
ARCH="arm64"

# Pantalla (FT8201P 4.7" 1280x960 hasta 120Hz)
SCREEN_RES="1280x960"
SCREEN_WIDTH=1280
SCREEN_HEIGHT=960
SCREEN_ROTATION=0
SCREEN_MAX_HZ=120

# Caracteristicas de hardware
HAS_SLIDER=0
JOYPAD_DEV="/dev/input/event3"
JOYPAD_NAME="retrogame_joypad"
HAS_RGB_LEDS=0
