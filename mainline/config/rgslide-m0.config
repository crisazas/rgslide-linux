# rgslide-linux Milestone M0 overrides layered on top of
# third_party/mu300-linux/upstream/mu300-mainline.config.

CONFIG_LOCALVERSION="-rgslide-m0"

# Verbose console + ramoops capture for early bring-up (LK cmdline is ignored).
CONFIG_CMDLINE="earlycon=sprd_serial,0x20210000,115200n8 console=ttyS1,115200n8 loglevel=7 log_buf_len=4M softlockup_panic=1 nmi_watchdog=panic oops=panic printk.devkmsg=on rdinit=/init panic=10 clk_ignore_unused pd_ignore_unused regulator_ignore_unused fw_devlink=permissive"
CONFIG_CMDLINE_FORCE=y

# Keep M0 builds fast and independent of host pahole/libelf.
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_BTF is not set

# Android binderfs + IPC (future container/Droidloom readiness).
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# Ensure USB gadget ECM + ACM + RNDIS are built in for M0 shell access.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y
