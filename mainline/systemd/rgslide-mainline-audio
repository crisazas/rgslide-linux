#!/bin/sh
# Bring up internal audio (AGDSP + VBC v4 + UMP9620 codec + sprdphone-sc2730)
# on the RG Slide running mainline Linux 6.18.
#
# Usage:
#   rgslide-mainline-audio load    # load modules & bind sprdphone-sc2730 card
#   rgslide-mainline-audio start   # load + boot l_agdsp_a firmware into AGDSP
#   rgslide-mainline-audio spk-on  # enable internal speaker mixer route
#   rgslide-mainline-audio spk-off # disable internal speaker mixer route
#   rgslide-mainline-audio test    # spk-on + prime + 440 Hz tone + spk-off
set -u

MOD="/lib/modules/$(uname -r)/extra"
BOOT="/sys/devices/platform/audiocp_boot"
DDR32_BASE="0xaf700000"
DDR32_SIZE="0x300000"
DSPBIN_BASE="0xafa00000"
DSPBIN_SIZE="0x600000"

loaded() {
    grep -q "^$(echo "$1" | tr '-' '_') " /proc/modules
}

load_mod() {
    m="$1"
    shift
    [ -f "$MOD/$m.ko" ] || return 0
    loaded "$m" && return 0
    /sbin/insmod "$MOD/$m.ko" "$@" 2>/dev/null
}

ensure_agdsp_part() {
    mkdir -p /dev/block/by-name
    for u in /sys/class/block/sd*[0-9]; do
        n=$(sed -n 's/^PARTNAME=//p' "$u/uevent")
        b=$(basename "$u")
        [ "$n" = "l_agdsp_a" ] && ln -sf "/dev/$b" /dev/block/by-name/l_agdsp_a
    done
}

load_all() {
    # Mailbox + SIPC + AGCP DMA first
    for m in unisoc-mailbox sprd-sipc-virt-bus sprd_power_manager sipc-core sprd-dma; do
        load_mod "$m"
    done

    # Two passes so deferred probes bind once their suppliers register
    for pass in 1 2; do
        load_mod audio_mem \
            "ddr32_base=$DDR32_BASE" "ddr32_size=$DDR32_SIZE" \
            "dspbin_base=$DSPBIN_BASE" "dspbin_size=$DSPBIN_SIZE"
        for m in agdsp_access audio_sipc sprd_audcp_boot sprd_audcp_dvfs \
                 audio-dsp-dump audio-pipe sprd_apipe mcdt_hw_r2p0 \
                 sprd-dmaengine-pcm sprd-platform-pcm-routing sprd-compr-2stage-dma \
                 snd-soc-sprd-vbc-v4 snd-soc-sprd-vbc-fe \
                 snd-soc-sprd-codec-ump9620-power snd-soc-sprd-codec-ump9620-power-dev \
                 snd-soc-sprd-codec-ump9620 snd-soc-sprd-dummy-codec; do
            load_mod "$m"
        done
        load_mod snd-soc-sprd-card dummy_on_defer=1
    done

    # Rebind sound@0 if it probed before all DAI components finished registering
    drv="/sys/bus/platform/drivers/vbc-rxpx-codec-sc27xx"
    if [ -d "$drv" ] && ! grep -q sprdphone /proc/asound/cards 2>/dev/null; then
        echo sound@0 > "$drv/unbind" 2>/dev/null || true
        sleep 1
        echo sound@0 > "$drv/bind" 2>/dev/null || true
        sleep 2
    fi

    cat /proc/asound/cards 2>/dev/null || true
}

start_dsp() {
    load_all
    if ! grep -q sprdphone /proc/asound/cards 2>/dev/null; then
        echo "rgslide-mainline-audio: sprdphone card did not register" >&2
        return 1
    fi
    ensure_agdsp_part
    if [ ! -e /dev/block/by-name/l_agdsp_a ] || [ ! -w "$BOOT/start" ]; then
        echo "rgslide-mainline-audio: missing l_agdsp_a or $BOOT/start" >&2
        return 1
    fi
    echo 1 > "$BOOT/stop"
    dd if=/dev/block/by-name/l_agdsp_a of="$BOOT/agdsp" bs=4096 count=1536 2>/dev/null
    echo 1 > "$BOOT/start"
    sleep 1
    echo "rgslide-mainline-audio: AGDSP started"
}

ctl_set() {
    python3 /usr/local/lib/rgslide/ctl.py set "$@" >/dev/null 2>&1
}

spk_on() {
    ctl_set "agdsp_access_en" 1
    python3 /usr/local/lib/rgslide/ctl.py write 93 1 >/dev/null 2>&1 || true
    python3 /usr/local/lib/rgslide/ctl.py write 94 1 >/dev/null 2>&1 || true
    for a in \
        'S_NORMAL_AP01_P_CODEC SWITCH|1' \
        'ag_iis0_ext_sel_v2|aud_4ad_iis0_da0' \
        'VBC_IIS_MST_WIDTH_SET|WD_16BIT' \
        'VBC_IIS_TX0_WD_SEL|WD_16BIT' \
        'DSP VBC Profile Select|1078657024' \
        'VBC DAC0 AUD MDG Set|4096 4096' \
        'VBC DAC0 DG Set|30 30' \
        'VBC_MUX_AP01_DSP_PLY|AP01_TO_DSP_ENABLE' \
        'DAC LRCLK Select|invert' \
        'HPL Mixer DACLHPL Switch|1' \
        'HPR Mixer DACRHPR Switch|1' \
        'HPL EAR Sel|HPL' \
        'HPL Gain HPL Playback Volume|1' \
        'HPR Gain HPR Playback Volume|1' \
        'DA AOR Switch|1' \
        'AO Mixer AOL Switch|1' \
        'AO Mixer AOR Switch|1' \
        'HP Virt Switch|1' \
        'DAC Gain DAC Playback Volume|1 1' \
        'Inter PA Config|303' \
        'Speaker Function|1' \
        'Speaker1 Function|1'; do
        n=${a%%|*}; v=${a#*|}
        # shellcheck disable=SC2086
        ctl_set "$n" $v || true
    done
    echo "rgslide-mainline-audio: speaker on"
}

spk_off() {
    for a in \
        'Speaker1 Function|0' \
        'Speaker Function|0' \
        'HP Virt Switch|0' \
        'HPL Mixer DACLHPL Switch|0' \
        'HPR Mixer DACRHPR Switch|0' \
        'S_NORMAL_AP01_P_CODEC SWITCH|0'; do
        n=${a%%|*}; v=${a#*|}
        # shellcheck disable=SC2086
        ctl_set "$n" $v || true
    done
    ctl_set "agdsp_access_en" 0
    echo "rgslide-mainline-audio: speaker off"
}

case "${1:-start}" in
load)    load_all ;;
start)   start_dsp ;;
spk-on)  spk_on ;;
spk-off) spk_off ;;
test)
    start_dsp
    spk_on
    pcm=$(awk -F'[-:]' '/NORMAL_AP01/{printf "/dev/snd/pcmC%dD%dp\n", $1, $2; exit}' /proc/asound/pcm 2>/dev/null)
    [ -n "$pcm" ] || pcm="/dev/snd/pcmC0D0p"
    echo "rgslide-mainline-audio: testing $pcm"
    timeout 6 /usr/local/bin/rgslide-play "$pcm" 1 0 >/dev/null 2>&1 || true
    timeout 10 /usr/local/bin/rgslide-play "$pcm" 2 1500
    spk_off
    ;;
*)
    echo "usage: $0 load|start|spk-on|spk-off|test" >&2
    exit 2
    ;;
esac
