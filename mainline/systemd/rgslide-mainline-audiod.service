[Unit]
Description=RG Slide mainline audio FIFO daemon (/run/rgslide/audio.fifo -> hw:0,1)
ConditionKernelVersion=>=6.0
After=rgslide-mainline-audio.service
Requires=rgslide-mainline-audio.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/rgslide-mainline-audiod
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
