[Unit]
Description=ES-DE Frontend on RG Slide mainline Linux 6.18 (Mesa Panfrost KMSDRM)
ConditionKernelVersion=>=6.0
After=rgslide-mainline-modules.service rgslide-mainline-audiod.service rgslide-mainline-brightness.service
Wants=rgslide-mainline-modules.service rgslide-mainline-audiod.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=console
Group=console
SupplementaryGroups=video render input audio
WorkingDirectory=/home/console
Environment=HOME=/home/console USER=console LOGNAME=console
ExecStart=/usr/local/bin/rgslide-mainline-esde
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
