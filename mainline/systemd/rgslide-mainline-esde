#!/bin/sh
# Native ES-DE launcher for RG Slide on mainline Linux 6.18 + Mesa Panfrost KMSDRM.
# Uses Debian's upstream SDL2 + Mesa GLVND (50_mesa.json), zero libhybris.
set -u

export HOME=/home/console
export USER=console
export LOGNAME=console
export SDL_VIDEODRIVER=kmsdrm
export SDL_KMSDRM_DEVICE_INDEX=1
export SDL_AUDIODRIVER=alsa
export SDL_GAMECONTROLLERCONFIG="19009b4d4b4800000111000000010000,retrogame_joypad,a:b0,b:b1,x:b3,y:b2,back:b8,start:b9,leftstick:b10,rightstick:b11,leftshoulder:b4,rightshoulder:b5,lefttrigger:b6,righttrigger:b7,dpup:h0.1,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,leftx:a0,lefty:a1,rightx:a3,righty:a4,platform:Linux,"
export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
export LD_LIBRARY_PATH="/usr/lib/aarch64-linux-gnu:/opt/es-de/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

mkdir -p /run/rgslide 2>/dev/null || true
echo menu > /run/rgslide/session 2>/dev/null || true

# Apply configured refresh rate (60/120 Hz from /etc/default/rgslide-display)
# before SDL2 KMSDRM initializes so ES-DE inherits the active CRTC mode.
if [ -x /usr/local/sbin/rgslide-mainline-refresh ]; then
    /usr/local/sbin/rgslide-mainline-refresh es 2>/dev/null || true
fi

exec /opt/es-de/bin/es-de "$@"
