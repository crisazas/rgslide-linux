#!/bin/sh
# Native RetroArch launcher for RG Slide on mainline Linux 6.18 + Mesa Panfrost KMS.
# Invokes Debian's native /usr/bin/retroarch with Mesa GLVND (50_mesa.json) and
# appends /etc/rgslide-mainline-retroarch.cfg on top of /etc/retroarch.cfg.
set -u

export HOME=/home/console
export USER=console
export LOGNAME=console
export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
export LD_LIBRARY_PATH="/usr/lib/aarch64-linux-gnu:/opt/retroarch/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

mkdir -p /run/rgslide 2>/dev/null || true
echo game > /run/rgslide/session 2>/dev/null || true

EXTRA_CFG=""
REFRESH=$(sed -n 's/^REFRESH=//p' /etc/default/rgslide-display 2>/dev/null | tail -n 1 | tr -d "\"' ")
if [ -x /usr/local/sbin/rgslide-mainline-refresh ]; then
    /usr/local/sbin/rgslide-mainline-refresh game 2>/dev/null || true
fi
if [ "$REFRESH" = "120" ]; then
    printf 'video_refresh_rate = "120.000000"\n' > /tmp/rgslide-ra-refresh.cfg 2>/dev/null || true
    EXTRA_CFG="/tmp/rgslide-ra-refresh.cfg"
fi

/usr/bin/retroarch \
    --config "${RGSLIDE_RA_CONFIG:-/etc/retroarch.cfg}" \
    --appendconfig="/etc/rgslide-mainline-retroarch.cfg${EXTRA_CFG:+|$EXTRA_CFG}" \
    "$@"
rc=$?

# Restore ES-DE refresh rate before returning control to ES-DE
if [ -x /usr/local/sbin/rgslide-mainline-refresh ]; then
    /usr/local/sbin/rgslide-mainline-refresh es 2>/dev/null || true
fi

echo menu > /run/rgslide/session 2>/dev/null || true
exit "$rc"
