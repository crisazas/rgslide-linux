#!/bin/sh
# rgslide-linux Milestone M0 bring-up initramfs.
# Brings up USB gadget (ECM network on 10.55.0.2 + ACM serial console) and logs
# boot diagnostics to /dev/kmsg (persisted via pstore/ramoops).
# Does NOT mount or modify userdata.

/bin/busybox mkdir -p /proc /sys /dev /tmp /run /config /var/run
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
/bin/busybox --install -s /bin

mkdir -p /dev/pts /sys/fs/pstore
mount -t devpts devpts /dev/pts 2>/dev/null || true
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null || true
mount -t pstore pstore /sys/fs/pstore 2>/dev/null || true

log() {
    echo "RGSLIDE-M0: $*" > /dev/kmsg 2>/dev/null || echo "RGSLIDE-M0: $*"
}

log "init started: $(uname -a)"
log "pstore entries: $(ls /sys/fs/pstore 2>/dev/null | tr '\n' ' ')"

# Wait for the USB Device Controller (expected: 25100000.dwc3)
for _ in $(seq 1 20); do
    [ -n "$(ls /sys/class/udc 2>/dev/null)" ] && break
    sleep 1
done

# Ensure USB-C/DWC3 role is set to device mode when userspace role control is active
for r in /sys/class/usb_role/*/role; do
    [ -w "$r" ] && echo device > "$r" 2>/dev/null || true
done

udc="$(ls /sys/class/udc 2>/dev/null | head -n 1)"
log "udc: ${udc:-none}"
log "deferred: $(tr '\n' ';' < /sys/kernel/debug/devices_deferred 2>/dev/null | cut -c1-700)"

if [ -n "$udc" ]; then
    mount -t configfs configfs /config 2>/dev/null || true
    g="/config/usb_gadget/rgslide"
    mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409" \
             "$g/functions/ecm.usb0" "$g/functions/acm.GS0"

    echo 0x1d6b > "$g/idVendor"
    echo 0x0104 > "$g/idProduct"
    echo "RG Slide Mainline M0" > "$g/strings/0x409/product"
    echo "rgslide-linux" > "$g/strings/0x409/manufacturer"
    echo "rgslide-m0" > "$g/strings/0x409/serialnumber"
    echo "02:50:00:00:55:02" > "$g/functions/ecm.usb0/dev_addr"
    echo "02:50:00:00:55:01" > "$g/functions/ecm.usb0/host_addr"
    echo "ECM+ACM" > "$g/configs/c.1/strings/0x409/configuration"

    ln -s "$g/functions/ecm.usb0" "$g/configs/c.1/"
    ln -s "$g/functions/acm.GS0" "$g/configs/c.1/"

    if echo "$udc" > "$g/UDC"; then
        log "usb gadget bound to $udc"
        ifconfig usb0 10.55.0.2 netmask 255.255.255.0 up
        log "usb0 up at 10.55.0.2"
    else
        log "ERROR: failed to bind usb gadget to $udc"
        sync
        reboot -f
    fi
else
    log "ERROR: no UDC found after 20s; usb/dwc3/phy drivers:"
    log "$(ls /sys/bus/platform/drivers 2>/dev/null | grep -iE 'usb|dwc|phy|sprd' | tr '\n' ' ')"
    log "warm rebooting to Slot B so ramoops preserves dmesg"
    sync
    sleep 1
    reboot -f
fi

find_userdata() {
    for u in /sys/class/block/*/uevent; do
        [ -r "$u" ] || continue
        grep -qx 'PARTNAME=userdata' "$u" 2>/dev/null || continue
        d="${u%/uevent}"; d="${d##*/}"
        [ -b "/dev/$d" ] && { echo "/dev/$d"; return 0; }
    done
    return 1
}

boot_rootfs() {
    part=""
    for _ in $(seq 1 10); do
        part="$(find_userdata)" && break
        sleep 0.5
    done
    [ -n "$part" ] || { log "rootfs: PARTNAME=userdata not found"; return 1; }
    mkdir -p /mnt/root
    if ! mount -t ext4 -o rw,noatime "$part" /mnt/root; then
        log "rootfs: failed to mount $part"
        return 1
    fi
    if [ ! -x /mnt/root/sbin/init ]; then
        log "rootfs: /mnt/root/sbin/init missing"
        umount /mnt/root
        return 1
    fi
    log "rootfs: switching root to $part (/sbin/init)"
    for d in proc sys dev run; do mkdir -p "/mnt/root/$d"; done
    umount /sys/kernel/debug 2>/dev/null || true
    umount /sys/fs/pstore 2>/dev/null || true
    umount /config 2>/dev/null || true
    mount --move /proc /mnt/root/proc
    mount --move /sys /mnt/root/sys
    mount --move /dev /mnt/root/dev
    mount --move /run /mnt/root/run
    exec switch_root /mnt/root /sbin/init
}

if ! grep -q 'rgslide.rescue=1' /proc/cmdline 2>/dev/null; then
    boot_rootfs || log "rootfs: switch_root failed, dropping to rescue shell"
fi

# Rescue shell fallback (ECM telnet :23 + ACM ttyGS0)
cat > /tmp/udhcpd.conf <<'EOF'
start 10.55.0.10
end 10.55.0.20
interface usb0
option subnet 255.255.255.0
lease_file /tmp/udhcpd.leases
EOF
touch /tmp/udhcpd.leases
udhcpd /tmp/udhcpd.conf
telnetd -p 23 -l /bin/sh
(while :; do getty -L 115200 ttyGS0 vt100 2>/dev/null || sleep 3; done) &
dmesg > /tmp/dmesg-boot.txt 2>/dev/null || true
log "rescue shell ready at 10.55.0.2 (telnet :23 + ttyGS0)"

while :; do
    sleep 60
done
