+					rotation,
+					index);
+		dpu_reg_set(ctx, REG_R6P0_LAY_EN, BIT(index));
+		return;
+	}
+
 	layer_reg_wr(ctx, REG_LAY_POS, offset, index);
 	layer_reg_wr(ctx, REG_LAY_SIZE, size, index);
 	layer_reg_wr(ctx, REG_LAY_CROP_START,
