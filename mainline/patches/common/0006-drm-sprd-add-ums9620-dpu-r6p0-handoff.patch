+static int sprd_vpu_pd_probe(struct platform_device *pdev)
+{
+	struct generic_pm_domain *genpd;
+
+	genpd = devm_kzalloc(&pdev->dev, sizeof(*genpd), GFP_KERNEL);
+	if (!genpd)
+		return -ENOMEM;
+
+	genpd->name = dev_name(&pdev->dev);
+	pm_genpd_init(genpd, NULL, false);
+	return of_genpd_add_provider_simple(pdev->dev.of_node, genpd);
+}
+
+static void sprd_vpu_pd_remove(struct platform_device *pdev)
+{
+}
+
+static const struct of_device_id sprd_vpu_pd_match[] = {
+	{ .compatible = "sprd,vpu-pd" },
+	{ /* sentinel */ },
+};
+
+static struct platform_driver sprd_vpu_pd_driver = {
+	.probe = sprd_vpu_pd_probe,
+	.remove = sprd_vpu_pd_remove,
+	.driver = {
+		.name = "sprd-vpu-pd",
+		.of_match_table = sprd_vpu_pd_match,
+	},
+};
+
 static struct platform_driver *sprd_drm_drivers[]  = {
+	&sprd_vpu_pd_driver,
 	&sprd_drm_driver,
 	&sprd_dpu_driver,
 	&sprd_dsi_driver,
