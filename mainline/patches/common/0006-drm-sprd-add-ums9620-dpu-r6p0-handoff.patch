+/* DPU R6P0 (UMS9620 / qogirn6pro) register offsets */
+#define REG_R6P0_DPU_CTRL	0x08
+#define REG_R6P0_DPU_CFG0	0x0C
+#define REG_R6P0_BG_COLOR	0x24
+#define REG_R6P0_LAY_EN		0x2C
