+#define REG_R6P0_LAY_PITCH	0x4C
+#define REG_R6P0_LAY_POS	0x50
+#define REG_R6P0_LAY_ALPHA	0x54
+#define REG_R6P0_LAY_CROP_START	0x60
+#define REG_R6P0_INT_EN		0x250
+#define REG_R6P0_INT_CLR	0x254
+#define REG_R6P0_INT_STS	0x258
+#define REG_R6P0_DPI_CTRL	0x260
+#define REG_R6P0_DPI_H_TIMING	0x264
+#define REG_R6P0_DPI_V_TIMING	0x268
+
+#define BIT_R6P0_DPU_REG_UPDATE	BIT(4)
+#define BIT_R6P0_INT_VSYNC	BIT(4)
+#define BIT_R6P0_INT_STOP_DONE	BIT(16)
+#define BIT_R6P0_INT_UPDATE_DONE BIT(18)
+
 /* Layer0 control registers */
 #define REG_LAY_BASE_ADDR0	0x30
 #define REG_LAY_BASE_ADDR1	0x34
