@@ -133,7 +137,40 @@
 
 static int sprd_drm_probe(struct platform_device *pdev)
 {
-	return drm_of_component_probe(&pdev->dev, component_compare_of, &drm_component_ops);
+	struct device *dev = &pdev->dev;
+	struct device_node *port0, *dpu_np, *ep, *dsi_np;
+	struct component_match *match = NULL;
+
+	dma_set_mask_and_coherent(dev, DMA_BIT_MASK(32));
+
+	/*
+	 * On UMS9620 (qogirn6pro), display-subsystem lists both dpu0 (MIPI-DSI)
+	 * and dpu1 (DisplayPort). Bind only dpu0 + dsi0 when dpu0 is qogirn6pro
+	 * so we don't stall waiting for an unbound dpu1 component.
+	 */
+	port0 = of_parse_phandle(dev->of_node, "ports", 0);
+	if (port0) {
+		dpu_np = of_get_parent(port0);
+		if (dpu_np && of_device_is_compatible(dpu_np, "sprd,qogirn6pro-dpu")) {
+			drm_of_component_match_add(dev, &match, component_compare_of, dpu_np);
+			ep = of_get_next_child(port0, NULL);
+			if (ep) {
+				dsi_np = of_graph_get_remote_port_parent(ep);
+				if (dsi_np) {
+					drm_of_component_match_add(dev, &match, component_compare_of, dsi_np);
+					of_node_put(dsi_np);
+				}
+				of_node_put(ep);
+			}
+			of_node_put(dpu_np);
+			of_node_put(port0);
+			return component_master_add_with_match(dev, &drm_component_ops, match);
+		}
+		of_node_put(dpu_np);
+		of_node_put(port0);
+	}
+
+	return drm_of_component_probe(dev, component_compare_of, &drm_component_ops);
 }
 
