diff --git a/es-core/src/Lang.cpp b/es-core/src/Lang.cpp
new file mode 100644
index 0000000..40174b2
--- /dev/null
+++ b/es-core/src/Lang.cpp
@@ -0,0 +1,95 @@
+#include "Lang.h"
+
+#include <cstdlib>
+#include <fstream>
+#include <unordered_map>
+
+namespace
+{
+	std::string cleanValue(const std::string& s)
+	{
+		std::string o;
+		for(char c : s)
+			if(c != '"' && c != '\'' && c != ' ' && c != '\t' && c != '\r' && c != '\n')
+				o += c;
+		return o;
+	}
+
+	std::string fileVar(const char* path, const std::string& key)
+	{
+		std::ifstream f(path);
+		std::string line, val;
+		while(std::getline(f, line))
+			if(line.compare(0, key.size() + 1, key + "=") == 0)
+				val = cleanValue(line.substr(key.size() + 1));
+		return val;
+	}
+
+	std::string detect()
+	{
+		const char* e = getenv("RGSLIDE_LANG");
+		if(e && (std::string(e) == "es" || std::string(e) == "en"))
+			return e;
+		std::string v = fileVar("/etc/default/rgslide-lang", "RGSLIDE_LANG");
+		if(v == "es" || v == "en")
+			return v;
+		v.clear();
+		const char* envs[3] = { getenv("LC_ALL"), getenv("LC_MESSAGES"), getenv("LANG") };
+		for(int i = 0; i < 3 && v.empty(); i++)
+			if(envs[i] && *envs[i])
+				v = envs[i];
+		if(v.empty())
+			v = fileVar("/etc/default/locale", "LANG");
+		if(v.empty())
+			v = fileVar("/etc/locale.conf", "LANG");
+		if(v.empty())
+			return "es";
+		if(v.compare(0, 2, "es") == 0 && (v.size() == 2 || v[2] == '_' || v[2] == '.' || v[2] == '@'))
+			return "es";
+		return "en";
+	}
+
+	struct Table
+	{
+		std::string code;
+		std::unordered_map<std::string, std::string> map;
+
+		Table()
+		{
+			code = detect();
+			const char* dir = getenv("RGSLIDE_LANGDIR");
+			std::ifstream f(std::string(dir && *dir ? dir : "/usr/share/rgslide/lang") + "/" + code + ".tr");
+			std::string line;
+			while(std::getline(f, line))
+			{
+				while(!line.empty() && (line.back() == '\r' || line.back() == '\n'))
+					line.pop_back();
+				size_t eq = line.find('=');
+				if(line.empty() || line[0] == '#' || eq == std::string::npos || eq == 0)
+					continue;
+				map[line.substr(0, eq)] = line.substr(eq + 1);
+			}
+		}
+	};
+
+	Table& table()
+	{
+		static Table t;
+		return t;
+	}
+}
+
+namespace Lang
+{
+	const std::string& code()
+	{
+		return table().code;
+	}
+
+	std::string tr(const std::string& key)
+	{
+		auto& m = table().map;
+		auto it = m.find(key);
+		return it == m.end() ? key : it->second;
+	}
+}
diff --git a/es-core/src/Lang.h b/es-core/src/Lang.h
new file mode 100644
index 0000000..b19e4cf
--- /dev/null
+++ b/es-core/src/Lang.h
@@ -0,0 +1,18 @@
+#pragma once
+#ifndef ES_CORE_LANG_H
+#define ES_CORE_LANG_H
+
+#include <string>
+
+// Idioma de la interfaz (es|en) para la RG Slide. La clave es el texto original en ingles; Lang::tr() devuelve la traduccion de
+// <dir>/<idioma>.tr (lineas clave=texto, '#' comentario; dir = $RGSLIDE_LANGDIR o /usr/share/rgslide/lang) o la propia clave si no hay.
+// Idioma: RGSLIDE_LANG > /etc/default/rgslide-lang > LC_ALL/LC_MESSAGES/LANG > /etc/default/locale > /etc/locale.conf; sin nada: es; C/otro: en.
+namespace Lang
+{
+	const std::string& code();
+	std::string tr(const std::string& key);
+}
+
+inline std::string _(const std::string& key) { return Lang::tr(key); }
+
+#endif // ES_CORE_LANG_H
