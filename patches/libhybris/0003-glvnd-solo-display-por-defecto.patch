@@ -33,6 +33,16 @@ extern "C" EGLDisplay __eglHybrisGetPlatformDisplayCommon(EGLenum platform,
 
 static const __EGLapiExports *__eglGLVNDApiExports = NULL;
 
+/* rgslide: este vendor solo atiende el display por defecto (EGL_DEFAULT_DISPLAY / EGL_NONE) y deja GBM, X11, Wayland y surfaceless a Mesa.
+ * Cualquier otra plataforma devuelve EGL_NO_DISPLAY sin tocar hybris: glvnd pasa entonces al siguiente vendor (Mesa). */
+static EGLDisplay
+__eglGLVNDGetPlatformDisplay(EGLenum platform, void *nativeDisplay, const EGLAttrib *attrib_list)
+{
+    if (platform != EGL_NONE || nativeDisplay != NULL)
+        return EGL_NO_DISPLAY;
+    return __eglHybrisGetPlatformDisplayCommon(platform, nativeDisplay, attrib_list);
+}
