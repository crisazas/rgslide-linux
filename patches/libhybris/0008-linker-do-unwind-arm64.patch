# libhybris arm64: do_dl_unwind_find_exidx tambien en aarch64.
# Va en linker.cpp bajo __arm__; sin esto el q.so parcheado compila pero falla al cargar
# (undefined symbol _Z23do_dl_unwind_find_exidxmPi). Complementa a 0005.
diff -ruN a/hybris/common/q/linker.cpp b/hybris/common/q/linker.cpp
--- a/hybris/common/q/linker.cpp	2026-11-26 14:33:31.642749970 -0600
+++ b/hybris/common/q/linker.cpp	2026-11-26 14:33:31.643591254 -0600
@@ -433,7 +433,7 @@
   return true;
 }
 
-#if defined(__arm__)
+#if defined(__arm__) || defined(__aarch64__)
 
 // For a given PC, find the .so that it belongs to.
 // Returns the base address of the .ARM.exidx section
