# libhybris: el linker q exporta android_dl_unwind_find_exidx tambien en arm64.
# En el arbol solo va bajo __arm__, asi que q.so no la exporta, libhybris-common no la
# resuelve por dlsym y el linker queda a medias (CHECK mod.static_offset == SIZE_MAX).
diff -ruN a/hybris/common/q/dlfcn.cpp b/hybris/common/q/dlfcn.cpp
--- a/hybris/common/q/dlfcn.cpp	2026-11-26 14:17:41.788657678 -0600
+++ b/hybris/common/q/dlfcn.cpp	2026-11-26 14:17:41.790195183 -0600
@@ -88,7 +88,7 @@
 void __loader_add_thread_local_dtor(void* dso_handle) __LINKER_PUBLIC__;
 void __loader_remove_thread_local_dtor(void* dso_handle) __LINKER_PUBLIC__;
 libc_shared_globals* __loader_shared_globals() __LINKER_PUBLIC__;
-#if defined(__arm__)
+#if defined(__arm__) || defined(__aarch64__)
 _Unwind_Ptr __loader_dl_unwind_find_exidx(_Unwind_Ptr pc, int* pcount) __LINKER_PUBLIC__;
 #endif
 }
@@ -211,7 +211,7 @@
   return __loader_dl_iterate_phdr(cb, data);
 }
 
-#if defined(__arm__)
+#if defined(__arm__) || defined(__aarch64__)
 _Unwind_Ptr __loader_dl_unwind_find_exidx(_Unwind_Ptr pc, int* pcount) {
   ScopedPthreadMutexLocker locker(&g_dl_mutex);
   return do_dl_unwind_find_exidx(pc, pcount);
@@ -388,7 +388,7 @@
   return __loader_dlclose(handle);
 }
 
-#if defined(__arm__)
+#if defined(__arm__) || defined(__aarch64__)
 _Unwind_Ptr android_dl_unwind_find_exidx(_Unwind_Ptr pc, int* pcount) {
   return __loader_dl_unwind_find_exidx(pc, pcount);
 }
diff -ruN a/hybris/common/q/linker.h b/hybris/common/q/linker.h
--- a/hybris/common/q/linker.h	2026-11-26 14:17:41.789478976 -0600
+++ b/hybris/common/q/linker.h	2026-11-26 14:17:41.790911815 -0600
@@ -121,7 +121,7 @@
 
 int do_dl_iterate_phdr(int (*cb)(dl_phdr_info* info, size_t size, void* data), void* data);
 
-#if defined(__arm__)
+#if defined(__arm__) || defined(__aarch64__)
 _Unwind_Ptr do_dl_unwind_find_exidx(_Unwind_Ptr pc, int* pcount);
 #endif
 
